{
  "name": "scout-travel-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scout travel intelligence platform: travel graph, user graph, topic graph, radar, truth layer, sentinel, rewards.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "db:migrate": "node --disable-warning=ExperimentalWarning scout/cli/db-migrate.ts",
    "db:reset": "node --disable-warning=ExperimentalWarning scout/cli/db-migrate.ts --reset",
    "db:status": "node --disable-warning=ExperimentalWarning scout/cli/db-migrate.ts --status",
    "travel:import:geography": "node --disable-warning=ExperimentalWarning scout/cli/travel-import.ts geography",
    "travel:import:airports": "node --disable-warning=ExperimentalWarning scout/cli/travel-import.ts airports",
    "travel:import:places": "node --disable-warning=ExperimentalWarning scout/cli/travel-import.ts places",
    "travel:import:gtfs": "node --disable-warning=ExperimentalWarning scout/cli/travel-import.ts gtfs",
    "travel:import:all": "node --disable-warning=ExperimentalWarning scout/cli/travel-import.ts all",
    "travel:normalize": "node --disable-warning=ExperimentalWarning scout/cli/travel-normalize.ts",
    "travel:geocode": "node --disable-warning=ExperimentalWarning scout/cli/travel-geocode.ts",
    "data:fetch": "python3 scripts/build_upstream.py",
    "data:fixtures": "python3 scripts/record_fixtures.py",
    "data:ingest": "SCOUT_TRANSPORT=offline node --disable-warning=ExperimentalWarning scout/cli/sourcemesh.ts ingest",
    "data:validate": "node --disable-warning=ExperimentalWarning scout/cli/data-validate.ts",
    "data:status": "node --disable-warning=ExperimentalWarning scout/cli/sourcemesh.ts status",
    "data:seed": "npm run data:fetch && npm run db:migrate && npm run data:ingest && npm run data:validate",
    "sourcemesh": "node --disable-warning=ExperimentalWarning scout/cli/sourcemesh.ts",
    "command-center": "node --disable-warning=ExperimentalWarning scout/cli/command-center.ts",
    "graph:user:build": "node --disable-warning=ExperimentalWarning scout/cli/graph-user-build.ts",
    "graph:topic:build": "node --disable-warning=ExperimentalWarning scout/cli/graph-topic-build.ts",
    "topics:discover": "node --disable-warning=ExperimentalWarning scout/cli/graph-topic-build.ts --discover",
    "truth:resolve": "node --disable-warning=ExperimentalWarning scout/cli/truth-resolve.ts",
    "radar:scan": "node --disable-warning=ExperimentalWarning scout/cli/radar-scan.ts",
    "radar:health": "node --disable-warning=ExperimentalWarning scout/cli/radar-health.ts",
    "radar:verify": "node --disable-warning=ExperimentalWarning scout/cli/radar-verify.ts",
    "sentinel:check": "node --disable-warning=ExperimentalWarning scout/cli/sentinel-check.ts",
    "rewards:quote": "node --disable-warning=ExperimentalWarning scout/cli/rewards-quote.ts",
    "recommend": "node --disable-warning=ExperimentalWarning scout/cli/recommend.ts",
    "api:serve": "node --disable-warning=ExperimentalWarning scout/cli/api-serve.ts",
    "scout:demo": "node --disable-warning=ExperimentalWarning scout/cli/scout-demo.ts",
    "bootstrap": "npm run db:migrate && npm run travel:import:all && npm run travel:normalize && npm run graph:topic:build && npm run graph:user:build && npm run truth:resolve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/scout/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
