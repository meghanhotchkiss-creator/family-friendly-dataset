# Copy to .env and fill in. NEVER commit .env -- this repository is public.
# Deployment values belong in Vercel/Cloud Run env settings, not in a file.

# --- Core API (required) ---------------------------------------------------
FAMILY_API_KEY=
JWT_SECRET=

# --- Data ------------------------------------------------------------------
# Local path or https:// URL. Defaults to data/processed/family_friendly_dataset.csv
FAMILY_DATASET_URL=
USE_BIGQUERY=false
BQ_TABLE=

# --- Browser clients -------------------------------------------------------
# Origins allowed to call the API cross-origin.
ALLOWED_ORIGINS=https://scoutfoxtravel.com,https://www.scoutfoxtravel.com

# Base URL every client (bots, dashboard, mobile, widgets) points at.
SCOUTFOX_API_URL=http://localhost:8000

# Browser-visible keys. These reach the user, so they are public by
# definition: use a free-tier, rate-limited key, never the business tier.
REACT_APP_SCOUTFOX_API_URL=http://localhost:8000
REACT_APP_SCOUTFOX_API_KEY=
EXPO_PUBLIC_SCOUTFOX_API_URL=http://localhost:8000
EXPO_PUBLIC_SCOUTFOX_API_KEY=

# --- Data sources ----------------------------------------------------------
# Free key, issued instantly: https://developer.nps.gov/get-started/
NPS_API_KEY=
# Billed per request. Restrict the key and set a quota cap before using it.
GOOGLE_PLACES_API_KEY=

# --- Payments (not yet live) ----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
SUCCESS_URL=https://scoutfoxtravel.com/welcome?session_id={CHECKOUT_SESSION_ID}
CANCEL_URL=https://scoutfoxtravel.com/pricing

# --- Affiliate (no programme joined yet) ----------------------------------
AFFILIATE_BASE_URL=
AFFILIATE_REF=

# --- Auth (optional) -------------------------------------------------------
FIREBASE_PROJECT_ID=

# --- Bots ------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
DISCORD_BOT_TOKEN=
